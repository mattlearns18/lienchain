# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it contains seed material.
#
# VITE_NETWORK selects the active XRPL network. Defaults to 'testnet' if unset.
# Set to 'mainnet' only when production billing and business setup are complete.

VITE_NETWORK=testnet

# Testnet seed — used CLIENT-SIDE for XRPL testnet tokenization. Safe to use
# a testnet-funded wallet here; no real funds at risk.
VITE_LIENCO_TESTNET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mainnet seed — set this only when ready for production. Leave blank on testnet.
# If VITE_NETWORK=mainnet and this is empty, the app will throw loudly at runtime.
VITE_LIENCO_MAINNET_SEED=

# XRPL WebSocket endpoints — defaults are used if these are unset.
VITE_XRPL_TESTNET_WSS=wss://s.altnet.rippletest.net:51233
VITE_XRPL_MAINNET_WSS=wss://xrplcluster.com
